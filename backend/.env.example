# ─────────────────────────────────────────────────────────
#  Capital Pyre — Backend Environment
#  Copy to backend/.env and fill in your values.
# ─────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=capitalpyre
DB_PASSWORD=changeme_db
DB_NAME=capitalpyre_db

# JWT
JWT_SECRET=replace_with_a_very_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# Email (Nodemailer — Gmail SMTP, same as IAMS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM="Capital Pyre <no-reply@capitalpyre.com>"

# CRS Scoring Microservice
CRS_SERVICE_URL=http://localhost:8000

# Redis (Socket.IO adapter)
REDIS_URL=redis://localhost:6379

# Frontend URL (CORS whitelist)
CLIENT_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
