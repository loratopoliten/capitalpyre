# ── Database ──────────────────────────────────────────────────
# For local development (MySQL):
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=capitalpyre_db

# For production (PostgreSQL / Supabase):
# DB_CLIENT=pg
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_long_random_secret_min_32_chars

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ── CRS Scoring Service ───────────────────────────────────────
CRS_SERVICE_URL=http://localhost:8000

# ── Email (Gmail SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=noreply@capitalpyre.com
FROM_NAME=Capital Pyre
