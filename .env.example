# ─────────────────────────────────────────────────────────
#  Capital Pyre — Root Environment Configuration
#  Copy this to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# MySQL (used by Docker Compose to spin up the db container)
DB_ROOT_PASSWORD=changeme_root
DB_NAME=capitalpyre_db
DB_USER=capitalpyre
DB_PASSWORD=changeme_db

# Frontend build arg (where the React app points its API calls)
VITE_API_URL=http://localhost:5000
